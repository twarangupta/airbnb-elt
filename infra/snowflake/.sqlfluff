# Admin DDL (warehouses, resource monitors, users) is aligned by hand for
# readability, and sqlfluff's Snowflake grammar indents these statements
# inconsistently. Layout rules are switched off for this folder only;
# every other rule (keywords, references, ambiguity) still applies.
[sqlfluff]
# RF04: RAW columns mirror the CSV headers exactly, and some headers are
#       keywords (date, source); they are renamed in dbt Silver models.
# RF03: Snowflake's METADATA$ pseudo-columns cannot be table-qualified.
exclude_rules = LT01, LT02, LT05, RF03, RF04
