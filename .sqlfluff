# sqlfluff settings (SQL linter). Read by `make lint` and by CI.
[sqlfluff]
dialect = snowflake
# Jinja templater: renders {{ }} and {% %} without connecting to Snowflake.
# apply_dbt_builtins fakes dbt functions like ref(), source(), config(), var().
templater = jinja
max_line_length = 120
# Keep the rule set small and explainable; grow it as models arrive.
# ST06 (select-column order by type) is off: models list columns in a
# logical order (keys, attributes, metrics, metadata) instead.
exclude_rules = LT05, ST06

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = dbt/macros
# Lint-only stand-ins for dbt_utils macros (see dbt/lint_stubs/dbt_utils).
library_path = dbt/lint_stubs

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
