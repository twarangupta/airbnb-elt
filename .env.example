# Copy this file to .env (which is gitignored) and fill in your own values.
# Never commit .env. Never paste these values into chat or code.

# ---------- AWS (Phase 1: landing files in S3) ----------
# Name of the AWS CLI / boto3 profile that holds the landing user's access key.
# The key itself lives in %USERPROFILE%\.aws\credentials, NOT in this file.
AWS_PROFILE=airbnb-elt-lander
# Fixed when the AWS free-plan project was created (see infra/aws/README.md step 1).
AWS_REGION=ap-south-1
S3_BUCKET=airbnb-elt-raw-CHANGE-ME
CITY=london

# ---------- Snowflake (Phase 2 onward; fill in only when the trial is active) ----------
# Account identifier looks like ORGNAME-ACCOUNTNAME (from Snowsight: Admin > Accounts).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DBT_SVC
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=AIRBNB_WH
SNOWFLAKE_DATABASE=AIRBNB
# Path to the private key file, kept OUTSIDE the repo (for example C:/Users/you/.snowflake/airbnb_elt_rsa_key.p8)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
