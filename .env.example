# Copy this file to .env (which is gitignored) and fill in your own values.
# Never commit .env. Never paste these values into chat or code.

# ---------- AWS (Phase 1: landing files in S3) ----------
# Access key of the IAM user airbnb-elt-lander (write/read on raw/ in one bucket only).
# Paste it into .env (gitignored), never here. The Makefile exports .env, and boto3
# reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION from the
# environment automatically, so no code ever handles the key directly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Fixed by the AWS free plan for this project (see infra/aws/README.md step 1).
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
S3_BUCKET=airbnb-elt-raw-CHANGE-ME
CITY=london

# ---------- Snowflake (Phase 2 onward; fill in only when the trial is active) ----------
# Account identifier looks like ORGNAME-ACCOUNTNAME (from Snowsight: Admin > Accounts).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DBT_SVC
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=AIRBNB_WH
SNOWFLAKE_DATABASE=AIRBNB
# Path to the private key file, kept OUTSIDE the repo (for example C:/Users/you/.snowflake/airbnb_elt_rsa_key.p8)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
